{
  "schema_version": 1,
  "kind": "statistical",
  "name": "3 op-amp instrumentation amplifier tolerance study",
  "description": "Starter template: classic discrete 3 op-amp instrumentation amplifier built from real LT1128 (Analog Devices/Linear Technology) ultra-low-noise precision op-amps, checking overall differential gain accuracy against gain-setting resistor tolerance.",
  "plan": {
    "variables": [
      {
        "name": "R1_VAL",
        "distribution": "gaussian",
        "nominal": 100000,
        "sigma": 1000,
        "minimum": 96000,
        "maximum": 104000,
        "unit": "ohm"
      },
      {
        "name": "RG_VAL",
        "distribution": "gaussian",
        "nominal": 2020,
        "sigma": 20.2,
        "minimum": 1939,
        "maximum": 2101,
        "unit": "ohm"
      }
    ],
    "sample_count": 8,
    "seed": 20260902,
    "correlations": [],
    "corner_axes": [],
    "sampling_method": "independent"
  },
  "experiments": [
    {
      "name": "ac",
      "netlist_path": "instrumentation-amp-starter/instrumentation_amp_3opamp.cir",
      "filename": "instrumentation_amp_3opamp.cir",
      "waveform_analyses": [
        {
          "name": "differential_gain",
          "variable": "V(out)",
          "secondary_variable": "V(inp)",
          "requirements": [
            {
              "metric": "ac_gain_db",
              "operator": ">=",
              "target": 39,
              "frequency_value": 1000
            },
            {
              "metric": "ac_gain_db",
              "operator": "<=",
              "target": 41,
              "frequency_value": 1000
            }
          ]
        }
      ]
    }
  ],
  "execution": {
    "max_concurrency": 2,
    "reuse_cache": true
  },
  "report_context": {
    "title": "3 Op-Amp Instrumentation Amplifier Tolerance Study",
    "circuit_summary": "Classic discrete 3 op-amp instrumentation amplifier (LT1128 precision op-amps), nominal differential gain ~100 (40 dB)."
  }
}
